# ====================================
# Configurações do Ambiente - ParkNow
# ====================================
# Copie este arquivo para `.env` e ajuste os valores antes de iniciar a aplicação.
# Valores marcados como (obrigatório) são validados no startup; o servidor não sobe sem eles em produção.

# --- Ambiente básico ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api
TRUST_PROXY=0
TZ=America/Sao_Paulo

# --- Segurança / JWT ---
# (obrigatório em produção) Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme_session_secret_min_32_chars
JWT_SECRET=changeme_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Banco de Dados (PostgreSQL) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DATABASE=parknow_db
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# --- E-mail (SMTP) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=changeme@example.com
EMAIL_PASS=changeme_app_password
EMAIL_FROM="ParkNow <noreply@example.com>"
EMAIL_SUPPORT=support@example.com
EMAIL_ADMIN=admin@example.com

# --- Cron / Tarefas agendadas ---
CRON_API_KEY=changeme_cron_api_key
CRON_EXPIRE_RESERVAS=*/5 * * * *
CRON_UPDATE_TEMPO=*/1 * * * *

# --- Segurança HTTP / Rate limiting ---
# Em milissegundos (15 min = 900000)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3000

# --- Observabilidade ---
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
# Endpoint /metrics em produção requer Bearer token (ou request via loopback).
METRICS_TOKEN=
# Error tracking opcional. Se definido + pacote @sentry/node instalado, eventos são enviados.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=

# --- Body parser ---
# Limite máximo de payload JSON/urlencoded aceito globalmente (default 10mb).
# Reduza para 1mb em deploys que não aceitam imagens base64.
BODY_LIMIT=10mb

# --- Uploads ---
UPLOAD_MAX_SIZE_MB=5

# --- Cache em memória ---
CACHE_DEFAULT_TTL=60
CACHE_EST_LIST_TTL=300

# --- Tempo real (Socket.IO) ---
REALTIME_ENABLED=true

# ====================================
# ASAAS Payment Gateway (gateway oficial)
# ====================================
ASAAS_SANDBOX=true
# Obtenha em https://sandbox.asaas.com (sandbox) ou https://www.asaas.com (produção)
ASAAS_SANDBOX_API_KEY=changeme_asaas_sandbox_key
ASAAS_API_KEY=changeme_asaas_production_key
ASAAS_PLATFORM_FEE_PERCENT=15.0
ASAAS_WEBHOOK_URL=${APP_URL}/api/webhooks/asaas
# Segredo configurado no painel ASAAS para validar a assinatura do webhook
ASAAS_WEBHOOK_SECRET=changeme_asaas_webhook_secret

# ====================================
# Integrações opcionais
# ====================================
# Google Maps (opcional, somente se for usar Maps em vez de OpenStreetMap)
GOOGLE_MAPS_API_KEY=

# ====================================
# Observações
# ====================================
# - Não comite o arquivo `.env` real; este `.env.example` deve conter apenas placeholders.
# - Integrações com Stripe e Gerencianet/PIX direto foram descontinuadas: utilize ASAAS.
