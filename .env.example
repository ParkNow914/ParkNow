# ====================================
# Configurações do Ambiente - ParkNow
# ====================================

# --- Ambiente Básico ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
TRUST_PROXY=0

# --- Segurança ---
SESSION_SECRET=seu_segredo_seguro_aqui
JWT_SECRET=seu_jwt_secret_aqui
JWT_REFRESH_SECRET=seu_refresh_secret_aqui
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES=30

# --- Banco de Dados (PostgreSQL) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=sua_senha_aqui
PG_DATABASE=parknow_db
PG_MAX_CONNECTIONS=100
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000

# --- E-mail (para notificações e alertas) ---
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app
EMAIL_FROM="ParkNow <seu_email@gmail.com>"
ADMIN_EMAIL=admin@seu_dominio.com

# --- Tarefas Agendadas (Cron Jobs) ---
CRON_API_KEY=sua_chave_secreta_aqui

# --- Mercado Pago V2 ---
# Modo sandbox (true) ou produção (false)
MP_SANDBOX=true

# Credenciais de produção (obrigatórias)
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_PROD
MP_PUBLIC_KEY=SUA_PUBLIC_KEY_PROD
MP_CLIENT_ID=SEU_CLIENT_ID
MP_CLIENT_SECRET=SEU_CLIENT_SECRET

# Credenciais de sandbox (usadas quando MP_SANDBOX=true)
MP_SANDBOX_ACCESS_TOKEN=TEST-SEU_ACCESS_TOKEN_SANDBOX
MP_SANDBOX_PUBLIC_KEY=TEST-SUA_PUBLIC_KEY_SANDBOX

# Configurações de webhook
MP_WEBHOOK_SECRET=seu_webhook_secret_aqui
MP_WEBHOOK_URL=${APP_URL}/api/v2/pagamentos/webhook

# Configurações de PIX
MP_PIX_EXPIRATION_MINUTES=30
MP_PIX_KEY_TYPE=CNPJ  # CNPJ ou CPF
MP_PIX_KEY=SEU_CNPJ_OU_CHAVE_PIX  # Chave PIX do estacionamento

# Configurações do fluxo PIX
PIX_CONFIRMATION_TIMEOUT_MINUTES=30
CRON_API_KEY=your_secure_cron_api_key_here
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Configurações de notificação
MP_NOTIFICATION_EMAIL=notificacoes@seu_dominio.com
MP_NOTIFICATION_URL=${FRONTEND_URL}/pagamento/notificacao

# Configurações de marketplace (opcional)
MP_MARKETPLACE_ENABLED=false
MP_MARKETPLACE_FEE=0
MP_MARKETPLACE_EMAIL=marketplace@seu_dominio.com

# ===================================
# Configuração da Aplicação
# ===================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api

# ===================================
# Configuração de Cache (Redis)
# ===================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600  # Tempo de vida do cache em segundos

# ===================================
# Configurações de Segurança
# ===================================
RATE_LIMIT_WINDOW_MS=15*60*1000  # 15 minutos
RATE_LIMIT_MAX=100  # Limite de requisições por janela de tempo
CORS_ORIGIN=http://localhost:3000

# ===================================
# Configurações de Log
# ===================================
LOG_LEVEL=info  # error, warn, info, debug
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log

# ===================================
# Configurações Adicionais
# ===================================
# Google Maps API (opcional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Tempo de expiração do QR Code PIX (em minutos)
PIX_EXPIRATION_MINUTES=30

# Configuração de timezone
TZ=America/Sao_Paulo

# PIX Configuration
PIX_ENABLED=false
PIX_PROVIDER=gerencianet  # gerencianet, mercadopago, etc.
PIX_BASE_URL=https://api-pix.gerencianet.com.br
PIX_CLIENT_ID=your_pix_client_id
PIX_CLIENT_SECRET=your_pix_client_secret
PIX_CERTIFICATE_PATH=./certs/certificate.p12
PIX_KEY=your_pix_key
PIX_WEBHOOK_URL=https://yourdomain.com/api/webhooks/pix
PIX_TOKEN_EXPIRES_IN=3600
PIX_CHARGE_EXPIRES_IN=3600
PIX_SANDBOX=true
PIX_DEBUG=true
PIX_NOTIFY_CUSTOMER=true
PIX_NOTIFY_EMAIL=parknow914@gmail.com
PIX_VALIDATE_WEBHOOK=true
PIX_WEBHOOK_SECRET=generate_a_secure_random_string

# File Upload Configuration
MAX_FILE_UPLOAD=1000000
FILE_UPLOAD_PATH=./public/uploads
