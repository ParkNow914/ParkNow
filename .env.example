# ====================================
# Configurações do Ambiente - ParkNow (always free)
# ====================================
# Copie este arquivo para `.env` e ajuste os valores antes de iniciar a aplicação.
# Valores marcados como (obrigatório) são validados no startup; o servidor não
# sobe sem eles em produção.
#
# Stack 100% always free: sem gateway de pagamento pago.
# O recebimento é feito via PIX direto na chave do estacionamento, com
# confirmação manual pelo admin (upload de comprovante pelo usuário).

# --- Ambiente básico ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api
TRUST_PROXY=0
TZ=America/Sao_Paulo

# --- Segurança / JWT ---
# (obrigatório em produção) Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme_session_secret_min_32_chars
JWT_SECRET=changeme_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Banco de Dados (PostgreSQL) ---
# Always-free options: Supabase (500MB) / Neon (3GB) / Postgres self-hosted no
# Oracle Cloud Free Tier (sem limite prático).
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DATABASE=parknow_db
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# --- E-mail (SMTP) ---
# Gmail SMTP é grátis até 500 emails/dia (use "senha de app" do Google).
# Alternativas always free: Brevo (300/dia), Resend (100/dia), MailerSend (3k/mês).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=changeme@example.com
EMAIL_PASS=changeme_app_password
EMAIL_FROM="ParkNow <no-reply@example.com>"
EMAIL_SUPPORT=support@example.com
EMAIL_ADMIN=admin@example.com

# --- Cron / Tarefas agendadas ---
CRON_API_KEY=changeme_cron_api_key
CRON_EXPIRE_RESERVAS=*/5 * * * *
CRON_UPDATE_TEMPO=*/1 * * * *

# --- Segurança HTTP / Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3000

# --- Observabilidade ---
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
# /metrics em produção requer Bearer token (ou request via loopback).
METRICS_TOKEN=
# Error tracking opcional (Sentry 5k errors/mês free). Sem isso, erros caem no Winston.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=

# --- Body parser ---
# Limite máximo de payload aceito globalmente (default 10mb, para uploads base64).
# Reduza para 1mb em deploys que não recebem imagens em base64.
BODY_LIMIT=10mb

# --- Uploads ---
# Tipos aceitos: jpg/png/gif/webp/pdf (configurado em config/index.js).
UPLOAD_MAX_SIZE_MB=5

# --- Cache em memória ---
CACHE_DEFAULT_TTL=60
CACHE_EST_LIST_TTL=300

# --- Tempo real (Socket.IO) ---
REALTIME_ENABLED=true

# ====================================
# Pagamentos (always free)
# ====================================
# Sem gateway externo — recebimento via PIX direto na chave do estacionamento.
# O usuário paga, anexa comprovante pela API e o admin confirma manualmente
# via painel ou endpoint `/api/admin/reservas/:id/confirmar-pagamento`.

# Tempo (em minutos) que uma reserva pendente sem confirmação ainda fica viva
# antes de ser cancelada automaticamente pelo cron.
PIX_PENDING_TIMEOUT_MIN=30

# ====================================
# Integrações opcionais
# ====================================
# Google Maps é opcional — o sistema usa OpenStreetMap (sem chave, free).
GOOGLE_MAPS_API_KEY=

# ====================================
# Observações
# ====================================
# - Não comite o arquivo `.env` real; este `.env.example` só tem placeholders.
# - Integrações com ASAAS, Stripe e Gerencianet foram REMOVIDAS — só usamos PIX
#   manual para manter o stack 100% always free.
# - Deploy recomendado: Oracle Cloud Free Tier (2 VMs ARM Ampere, 24GB RAM total,
#   200GB disco, sem expirar). Ver docs/DEPLOY_ORACLE_FREE_TIER.md.
