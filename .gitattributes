# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Config files
.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
README* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.gz binary
*.tar binary

# Linguist overrides
*.sql linguist-detectable=true
*.md linguist-detectable=true
docs/** linguist-documentation
tests/** linguist-vendored=false
migrations/** linguist-vendored=false

# Export ignore
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
docs/ export-ignore
*.md export-ignore
