# ============================================================================
# Configurações da Aplicação
# ============================================================================

# Nome e versão da aplicação
APP_NAME=payment-gateway
APP_VERSION=1.0.0
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ============================================================================
# Configurações de Segurança
# ============================================================================

# Chave secreta para JWT (gerar com: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'));"`)
JWT_SECRET=seu_jwt_secret_aqui_muito_seguro_e_aleatorio
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# ============================================================================
# Configurações do Mercado Pago
# ============================================================================
# Obtenha as credenciais em: https://www.mercadopago.com.br/developers/panel/credentials
MP_ACCESS_TOKEN=TEST-1234567890123456-123456-1234567890abcdef1234567890abcdef-123456789
MP_PUBLIC_KEY=TEST-12345678-1234-1234-1234-1234567890ab
MP_RECEIVER_PRIMARY_ID=1234567890  # ID do recebedor primário (ParkNow)
MP_RECEIVER_SECONDARY_ID=0987654321  # ID do recebedor secundário (Estacionamento)
MP_PLATFORM_FEE=0.10  # 10% de taxa da plataforma
MP_WEBHOOK_URL=https://sua-api.com/api/v1/payments/webhook
MP_NOTIFICATION_URL=https://sua-api.com/api/v1/payments/notifications

# ============================================================================
# Configurações de Banco de Dados
# ============================================================================
# Formato: postgres://usuario:senha@localhost:5432/nome_do_banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_gateway
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# ============================================================================
# Configurações de CORS
# ============================================================================
# Domínios permitidos (separados por vírgula)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://seu-frontend.com

# ============================================================================
# Configurações de Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos em milissegundos
RATE_LIMIT_MAX=100  # Máximo de requisições por janela

# ============================================================================
# Configurações de Log
# ============================================================================
# Níveis: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug
LOG_FILE=logs/app.log
LOG_FILE_MAX_SIZE=5m
LOG_FILE_MAX_FILES=14d

# ============================================================================
# Configurações de E-mail (opcional para notificações)
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@example.com
SMTP_PASSWORD=sua-senha-segura
EMAIL_FROM="ParkNow <noreply@parknow.com.br>"

# ============================================================================
# Configurações de Cache (opcional - Redis)
# ============================================================================
# Descomente e configure se estiver usando Redis
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=300  # 5 minutos

# ============================================================================
# Configurações de Fila (opcional - Bull/Redis)
# ============================================================================
# Descomente e configure se estiver usando filas
# QUEUE_CONNECTION=redis://localhost:6379

# ============================================================================
# Configurações de Monitoramento (opcional)
# ============================================================================
# Descomente e configure se estiver usando Sentry
# SENTRY_DSN=sua-dsn-do-sentry-aqui

# Descomente e configure se estiver usando New Relic
# NEW_RELIC_LICENSE_KEY=sua-licenca-new-relic-aqui

# ============================================================================
# Configurações de Armazenamento (opcional - AWS S3)
# ============================================================================
# Descomente e configure se estiver usando AWS S3
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=sua-access-key-id
# AWS_SECRET_ACCESS_KEY=sua-secret-access-key
# AWS_REGION=sa-east-1
# AWS_BUCKET_NAME=seu-bucket

# ============================================================================
# Configurações para Ambiente de Produção
# ============================================================================
# Descomente e ajuste para produção
# NODE_ENV=production
# PORT=80
# LOG_LEVEL=info
# DB_SSL=true
# CORS_ORIGIN=https://seu-frontend-prod.com
# SMTP_SECURE=true
# SMTP_PORT=465
