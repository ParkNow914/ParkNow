doctype html
html
  head
    style.
      body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background-color: #3498db; color: white; padding: 20px; text-align: center; border-radius: 5px 5px 0 0; }
      .content { padding: 20px; border: 1px solid #ddd; border-top: none; border-radius: 0 0 5px 5px; }
      .button { display: inline-block; padding: 10px 20px; background-color: #3498db; color: white; text-decoration: none; border-radius: 5px; margin: 20px 0; }
      .footer { margin-top: 20px; font-size: 12px; color: #777; text-align: center; }
  body
    .header
      h1 Senha Alterada com Sucesso
    .content
      p Olá #{firstName},
      p Sua senha foi alterada com sucesso em #{new Date().toLocaleString('pt-BR')}.
      p Se você não realizou esta alteração, entre em contato imediatamente com nosso suporte.
      p(style="margin-top: 30px;")
        | Acesse sua conta:
        br
        a(href=`${process.env.FRONTEND_URL || '#'}/login`, class="button") Acessar Minha Conta
      p Atenciosamente,
      p Equipe ParkNow
    .footer
      p © #{new Date().getFullYear()} ParkNow. Todos os direitos reservados.
