# terraform.tfvars.example
#
# COPIE este arquivo para `terraform.tfvars` e preencha com seus valores.
# O `.gitignore` deste diretório IGNORA `terraform.tfvars` para evitar leak
# de credenciais.

# ─── Credenciais OCI ────────────────────────────────────────────────────
# Encontre em https://cloud.oracle.com → Profile (canto superior direito).
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaa..."
user_ocid        = "ocid1.user.oc1..aaaaaaaa..."
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "C:/Users/alimi/.oci/oci_api_key.pem"

# Região onde a VM vai rodar. Veja https://docs.oracle.com/iaas/Content/General/Concepts/regions.htm
# Para Brasil: sa-saopaulo-1 ou sa-vinhedo-1.
region = "sa-saopaulo-1"

# Compartment onde criar os recursos. Se não tem compartments separados,
# use o mesmo valor de tenancy_ocid (o root compartment).
compartment_ocid = "ocid1.tenancy.oc1..aaaaaaaa..."

# ─── SSH ─────────────────────────────────────────────────────────────────
# Caminho para sua chave SSH PÚBLICA. Se não tem, gere uma:
#   ssh-keygen -t ed25519 -C "parknow"
ssh_public_key_path = "C:/Users/alimi/.ssh/id_ed25519.pub"

# ─── Aplicação ──────────────────────────────────────────────────────────
# Hostname público — aponte o DNS aqui DEPOIS do apply (output mostra o IP).
# Recomendado: crie um subdomínio gratuito em https://www.duckdns.org/
domain = "parknow.duckdns.org"

# SMTP para envio de emails (Gmail aceita "senha de app" gerada em
# https://myaccount.google.com/apppasswords — exige 2FA ativo).
email_user = "seu-email@gmail.com"
email_pass = "abcd efgh ijkl mnop"

# ─── (Opcionais — só descomentar para overrides) ─────────────────────────
# name_prefix              = "parknow"
# instance_shape           = "VM.Standard.A1.Flex"
# ocpus                    = 4
# memory_in_gbs            = 24
# boot_volume_size_in_gbs  = 50
# repo_url                 = "https://github.com/ParkNow914/ParkNow.git"
